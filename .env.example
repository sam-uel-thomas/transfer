# Copy to .env.local for development. In production, set the same variables
# in Vercel (Project > Settings > Environment Variables).
# None of these are exposed to the browser: there is no NEXT_PUBLIC_ variable.

# --- App --------------------------------------------------------------------
# Public origin of the app, no trailing slash. Used for links in emails and
# for the magic-link redirect. Must match the origin you open in the browser.
APP_URL=http://localhost:3000

# The only email address allowed to sign in and upload.
ALLOWED_EMAIL=you@example.com

# --- Supabase (Project Settings > API) ---------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# "anon" / publishable key. Used only for the magic-link session.
SUPABASE_ANON_KEY=
# "service_role" / secret key. Bypasses RLS. Server only; never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (R2 > Overview, and R2 > Manage API Tokens) --------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=transfer

# --- Resend ------------------------------------------------------------------
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend.
EMAIL_FROM="Transfer <transfer@yourdomain.com>"

# --- Secrets you generate yourself: `openssl rand -base64 32` ---------------
# Signs the password-unlock cookie. At least 32 characters.
COOKIE_SECRET=
# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
